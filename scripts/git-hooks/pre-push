#!/usr/bin/env bash
# Pre-push local (NFR-SEC-01, repositorio público). Bloquea el push si los
# commits que se van a subir contienen:
#   1. un secreto según gitleaks (misma versión y sha256 que ci.yml), o
#   2. un valor de .env (p. ej. la dirección del banco) o el host de una URL de .env, o
#   3. una MAC que no sea del DUT (dut.identity, publicada por H-20) ni la de
#      ejemplo del FSD: la radio del banco o un teléfono no entran en el repo.
# Los patrones se leen de .env en cada ejecución y nunca se escriben en disco.
# Activación (una vez por clon):  git config core.hooksPath scripts/git-hooks
set -euo pipefail

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ROOT=$(git rev-parse --show-toplevel)
CACHE="$(git rev-parse --git-common-dir)/tools"
GL="$CACHE/gitleaks-$GITLEAKS_VERSION"
ZERO=0000000000000000000000000000000000000000

fail() { echo "pre-push: BLOQUEADO — $*" >&2; exit 1; }

if [ ! -x "$GL" ]; then
  mkdir -p "$CACHE"; tmp=$(mktemp -d)
  curl -sSfL -o "$tmp/gl.tgz" \
    "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
    || fail "no se pudo descargar gitleaks (sin red no se puede revisar: no se sube)"
  echo "${GITLEAKS_SHA256}  $tmp/gl.tgz" | sha256sum -c - >/dev/null || fail "sha256 de gitleaks no coincide"
  tar xzf "$tmp/gl.tgz" -C "$tmp" gitleaks && mv "$tmp/gitleaks" "$GL" && rm -rf "$tmp"
fi

# Patrones de .env: cada valor no vacío (≥ 4 caracteres) y el host de cada URL.
patterns=$(mktemp); trap 'rm -f "$patterns"' EXIT
if [ -f "$ROOT/.env" ]; then
  sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\?[A-Za-z_][A-Za-z0-9_]*=//p' "$ROOT/.env" \
    | sed -e 's/^["'\'']//' -e 's/["'\'']$//' | while IFS= read -r v; do
        [ ${#v} -ge 4 ] && printf '%s\n' "$v"
        h=$(printf '%s' "$v" | sed -n 's#^[a-z][a-z0-9+.-]*://\([^/:@]*\).*#\1#p')
        [ -n "$h" ] && [ ${#h} -ge 4 ] && printf '%s\n' "$h"
        true   # un valor que no es URL no puede terminar el bucle en 1 (pipefail + set -e)
      done | sort -u > "$patterns"
else
  echo "pre-push: aviso — sin .env, solo se pasa gitleaks" >&2
fi

checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                       # borrado de rama
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha --not --remotes"
  else range="$remote_sha..$local_sha"; fi
  n=$(git rev-list --count $range)
  [ "$n" -eq 0 ] && continue
  checked=$((checked + n))
  "$GL" git --redact --no-banner --exit-code 1 --log-opts="$range" "$ROOT" >/dev/null 2>&1 \
    || fail "gitleaks encuentra un secreto en $range (repite: $GL git --redact --log-opts='$range' .)"
  if [ -s "$patterns" ]; then
    # Diffs y mensajes de los commits que se suben; nunca se imprime el patrón.
    # Contar, no `grep -q`: con pipefail, -q corta la tubería en el primer hallazgo,
    # git log muere por SIGPIPE (141) y el `if` leería «sin hallazgo» en un diff
    # de más de ~64 KB (H-74).
    hits=$(set +o pipefail; git log -p --format='%B' $range | grep -F -c -f "$patterns" || true)
    [ "$hits" -eq 0 ] || fail "un valor de .env aparece en los commits que se suben ($range)"
  fi
  # MAC en las líneas añadidas, salvo las del DUT y la de ejemplo del FSD
  pre=$(sed -n 's/^    mac: \([0-9a-fA-F:]\{14\}\).*/\1/p' "$ROOT/testing/test-plan.yaml" | head -1 | tr 'A-F' 'a-f')
  # (sin pipefail aquí: un grep sin coincidencias no es un error)
  ajenas=$(set +o pipefail; git log -p --format= $range | grep '^+' | grep -oiE '\b([0-9a-f]{2}:){5}[0-9a-f]{2}\b' | tr 'A-F' 'a-f' \
           | grep -v '^24:0a:c4:a1:b2:c3$' | { [ -n "$pre" ] && grep -v "^$pre" || cat; } | sort -u | wc -l)
  [ "$ajenas" -eq 0 ] || fail "$ajenas MAC ajena(s) al DUT en los commits que se suben ($range); redáctalas (<mac>)"
done
echo "pre-push: $checked commit(s) revisados — gitleaks y $(wc -l < "$patterns") patrón(es) de .env sin hallazgos" >&2
