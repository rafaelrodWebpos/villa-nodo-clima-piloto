# Nodo Clima Piloto — configuración de producción (fuente; sdkconfig se genera)
CONFIG_IDF_TARGET="esp32s3"

# C-HW-01/02: 8 MB fijos, sin autodetección
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# C-BLD-01: tabla de particiones del FSD §2.2
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# C-HW-03: el firmware no requiere PSRAM
# CONFIG_SPIRAM is not set

# C-LOG-01 / FR-LOG-01: sin log UDP en producción
# CONFIG_NODO_UDP_LOG is not set
# CONFIG_NODO_BENCH_BUILD is not set

# C-HW-08: consola primaria en UART0 (CH343) y copia por USB-Serial/JTAG
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# NFR-WDT-01 (D16): watchdog de tareas de 30 s que reinicia (reset = task_wdt)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
